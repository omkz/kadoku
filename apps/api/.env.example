ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://kadoku:kadoku@localhost:5432/kadoku
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Better Auth account IDs from signed JWT sub; leave blank to deny all admin access
ADMIN_USER_IDS=
GUEST_QUOTA_SECRET=replace-with-a-random-32-plus-character-secret
GUEST_RECOMMENDATIONS_DAILY=3
MEMBER_RECOMMENDATIONS_DAILY=5
# Leave empty to use free deterministic ranking/extraction (local demo)
AI_MODEL=
AI_TIMEOUT_SECONDS=12
AI_MAX_OUTPUT_TOKENS=240
# AG Studio AI Analyst is admin-only and opt-in. Defaults to OFF.
# LiteLLM is installed by default with uv sync (add --extra test for test deps).
# Keep all AI provider keys in this backend .env only; never NEXT_PUBLIC_*.
STUDIO_AGENT_ENABLED=false
STUDIO_AGENT_MODEL=
# Optional shopper AI (independent of Studio AI Analyst):
# AI_MODEL=gemini/gemini-2.5-flash
# GEMINI_API_KEY=your-own-Gemini-key
# Studio AI Analyst: choose one provider/model below.
# Nebius Token Factory (uses applicable API credits):
# STUDIO_AGENT_MODEL=nebius/zai-org/GLM-5.3-Flash
# NEBIUS_API_KEY=your-own-token-factory-key
# GroqCloud (separate API key, free tier available):
# STUDIO_AGENT_MODEL=groq/openai/gpt-oss-120b
# GROQ_API_KEY=your-own-groq-key
# Gemini (may reuse the Gemini key from shopper AI):
# STUDIO_AGENT_MODEL=gemini/gemini-2.5-flash
# For Gemini free-tier 5 RPM, pace AI Analyst model calls about 15 seconds apart.
# This does not increase the 20 requests/day quota.
STUDIO_AGENT_MIN_INTERVAL_SECONDS=0
# AI_MODEL and STUDIO_AGENT_MODEL are independent. When STUDIO_AGENT_MODEL is
# empty, Studio AI falls back to AI_MODEL (if STUDIO_AGENT_ENABLED=true).
# AI_MODEL=openai/<your-model> is also supported with OPENAI_API_KEY.
# Do not set production PayPal before tax, shipping and fulfillment implementation.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
