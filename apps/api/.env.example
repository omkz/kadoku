ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://kadoku:local-only-password@localhost:5432/kadoku
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

GUEST_QUOTA_SECRET=replace-with-a-random-32-plus-character-secret
GUEST_RECOMMENDATIONS_DAILY=3
MEMBER_RECOMMENDATIONS_DAILY=5

# Shopper AI (optional; empty uses rules-based recommendations).
AI_MODEL=
AI_TIMEOUT_SECONDS=12
AI_MAX_OUTPUT_TOKENS=240
# AI_MODEL=gemini/gemini-2.5-flash
# GEMINI_API_KEY=your-Gemini-key

# Admin AI Analyst (optional, disabled by default).
STUDIO_AGENT_ENABLED=false
STUDIO_AGENT_MODEL=
STUDIO_AGENT_MIN_INTERVAL_SECONDS=0
# Nebius Token Factory:
# STUDIO_AGENT_MODEL=nebius/zai-org/GLM-5.3-Flash
# NEBIUS_API_KEY=your-Nebius-key
# Alternatives: gemini/gemini-2.5-flash or groq/openai/gpt-oss-120b
# If STUDIO_AGENT_MODEL is empty, the agent uses AI_MODEL.
# For low Gemini RPM quotas, set STUDIO_AGENT_MIN_INTERVAL_SECONDS=15.

# Currently Sandbox-only; PayPal Live requires future integration work.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
