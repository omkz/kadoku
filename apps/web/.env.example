API_PROXY_TARGET=http://localhost:8000
AUTH_DATABASE_URL=postgresql://kadoku:kadoku@localhost:5432/kadoku
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters
# MUST match FastAPI GUEST_QUOTA_SECRET
GUEST_COOKIE_SECRET=replace-with-the-same-32-plus-character-secret
# Local development seed only (replace password before use; never commit real credentials)
DEV_ADMIN_EMAIL=admin@kadoku.local
DEV_ADMIN_PASSWORD=change-this-local-admin-password
# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
