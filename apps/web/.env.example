API_PROXY_TARGET=http://localhost:8000
AUTH_DATABASE_URL=postgresql://kadoku:local-only-password@localhost:5432/kadoku
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters
# MUST match FastAPI GUEST_QUOTA_SECRET
GUEST_COOKIE_SECRET=replace-with-the-same-32-plus-character-secret
# Optional manual local seed: run `pnpm run db:seed` from repository root.
# Three distinct 8+ character passwords; do not commit real credentials.
# Emails and passwords are required here for local demo provisioning.
# Existing accounts must match identity and password; seeds never reset passwords.
DEV_ADMIN_EMAIL=admin@kadoku.test
DEV_ADMIN_PASSWORD=
DEV_ADMIN_NAME=Demo Admin
DEV_SUPER_ADMIN_EMAIL=superadmin@kadoku.test
DEV_SUPER_ADMIN_PASSWORD=
DEV_SUPER_ADMIN_NAME=Super Admin
DEV_CUSTOMER_EMAIL=customer@kadoku.test
DEV_CUSTOMER_PASSWORD=
DEV_CUSTOMER_NAME=Demo Customer
# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
